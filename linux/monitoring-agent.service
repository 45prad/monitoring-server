[Unit]
Description=Monitoring Agent API Server
After=network.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/monitoring-agent/server.py
WorkingDirectory=/opt/monitoring-agent
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=monitoring-agent
# Allow root so iptables / journalctl -u work without sudo password
User=root

[Install]
WantedBy=multi-user.target

